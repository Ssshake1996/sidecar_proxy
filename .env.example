# Host port exposed by docker compose.
PROMPT_AUDIT_PORT=8090
PROMPT_AUDIT_HTTPS_PORT=8443

# Dedicated audit PostgreSQL created by docker-compose.yml.
# Use URL-safe values because the password is interpolated into a connection URL.
PROMPT_AUDIT_DB_USER=prompt_audit
PROMPT_AUDIT_DB_PASSWORD=change_me_before_deploy
PROMPT_AUDIT_DB_NAME=prompt_audit

# Existing sub2api service and its PostgreSQL database.
PROMPT_AUDIT_UPSTREAM_URL=http://host.docker.internal:8080
PROMPT_AUDIT_IDENTITY_DATABASE_URL=postgres://sub2api_audit_reader:change_me@host.docker.internal:5432/sub2api?sslmode=disable
PROMPT_AUDIT_IDENTITY_HMAC_SECRET=replace_with_openssl_rand_hex_32

# HTTP is enabled by default. HTTPS is enabled when the address and both
# certificate paths are configured. The certificate files are mounted from
# PROMPT_AUDIT_TLS_CERT_DIR in docker-compose.yml.
PROMPT_AUDIT_HTTP_ADDR=:8090
PROMPT_AUDIT_HTTPS_ADDR=
PROMPT_AUDIT_TLS_CERT_FILE=/run/prompt-audit/certs/fullchain.pem
PROMPT_AUDIT_TLS_KEY_FILE=/run/prompt-audit/certs/privkey.pem

# Optional legacy machine token for curl/API clients. Browser access uses the
# generated administrator account and session cookie.
PROMPT_AUDIT_ADMIN_TOKEN=
PROMPT_AUDIT_ADMIN_USERNAME=admin
# Leave empty to generate a random password on first deployment.
PROMPT_AUDIT_ADMIN_PASSWORD=
PROMPT_AUDIT_ADMIN_SESSION_TTL=12h

PROMPT_AUDIT_IDENTITY_REFRESH=30s
PROMPT_AUDIT_CAPTURE_PREFIXES=/v1,/v1beta
PROMPT_AUDIT_MAX_CAPTURE_BYTES=1048576
PROMPT_AUDIT_MAX_PROMPT_BYTES=1048576
PROMPT_AUDIT_QUEUE_SIZE=2048
PROMPT_AUDIT_CAPTURE_UNKNOWN_IDENTITY=false
PROMPT_AUDIT_CAPTURE_EMPTY_PROMPTS=false
PROMPT_AUDIT_RETENTION_DAYS=90
PROMPT_AUDIT_WEBSOCKET=true
PROMPT_AUDIT_SHUTDOWN_TIMEOUT=10s

# Only needed with docker-compose.network.yml.
# SUB2API_DOCKER_NETWORK=sub2api_default

# Optional directory containing fullchain.pem and privkey.pem.
# PROMPT_AUDIT_TLS_CERT_DIR=./certs
